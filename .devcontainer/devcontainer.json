{
  "image": "jdxcode/mise:debian",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "plugins": "zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions https://github.com/zsh-users/zsh-syntax-highlighting"
    }
  },
  "forwardPorts": [80, 5432, 8025],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "mounts": [
    {
      "type": "volume",
      "source": "claude-code-config-${devcontainerId}",
      "target": "/home/vscode/.claude"
    },
    {
      "type": "volume",
      "source": "github-cli-config",
      "target": "/home/vscode/.config/gh"
    }
  ],
  "remoteUser": "vscode",
  "onCreateCommand": {
    "claude-code": "sudo chown $(id -u):$(id -g) ${CLAUDE_CONFIG_DIR}",
    "github-cli": "sudo chown $(id -u):$(id -g) ${HOME}/.config/gh",
    // The mise directories baked into the image are owned by root, so change
    // their ownership to the non-root user before installing anything.
    // Use `mise trust` instead of `MISE_TRUSTED_CONFIG_PATHS`, because tools
    // such as the Oxc extension start processes without the container's
    // environment variables.
    "mise": "sudo chown -R $(id -u):$(id -g) ${MISE_DATA_DIR} && mise trust && mise bootstrap -y"
  },
  "postCreateCommand": "pnpm ci",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "bierner.markdown-preview-github-styles",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "exiasr.hadolint",
        "github.vscode-github-actions",
        "oxc.oxc-vscode",
        "redhat.vscode-yaml",
        "tekumara.typos-vscode",
        "tombi-toml.tombi"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
